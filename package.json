{
  "name": "@frankzhang2026/opencode-android-orchestrator",
  "version": "0.3.0",
  "description": "Reusable OpenCode orchestration for Android projects",
  "license": "MIT",
  "author": "frankzhang2026",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankzhangtx/npm-orchestrator-plugin.git"
  },
  "homepage": "https://github.com/frankzhangtx/npm-orchestrator-plugin#readme",
  "bugs": {
    "url": "https://github.com/frankzhangtx/npm-orchestrator-plugin/issues"
  },
  "type": "module",
  "main": "./dist/opencode-plugin.js",
  "types": "./dist/opencode-plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/opencode-plugin.d.ts",
      "import": "./dist/opencode-plugin.js"
    },
    "./api": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-android-orchestrator": "dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/",
    "templates/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "keywords": [
    "opencode",
    "android",
    "automation",
    "orchestration"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.22 <1.16.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.14.22",
    "@types/node": "22.13.9",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
