{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frankzhang2026:opencode-android-orchestrator:installation-manifest:v1",
  "title": "OpenCode Android Orchestrator installation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "installation",
    "backupDirectory",
    "files"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\s)(?!.*\\s$)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)(?!.*\\u0000)(?!.*\\/$).+"
    },
    "managedPath": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "pattern": "^(?!\\.automation-plugin(?:/|$)).+"
        }
      ]
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "name",
                "version"
              ],
              "properties": {
                "kind": {
                  "const": "registry"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "name",
                "version",
                "artifact",
                "sha256",
                "sha512",
                "packageRoot",
                "entry",
                "files"
              ],
              "properties": {
                "kind": {
                  "const": "local-tgz"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "artifact": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "sha512": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{128}$"
                },
                "packageRoot": {
                  "type": "string",
                  "minLength": 1
                },
                "entry": {
                  "type": "string",
                  "pattern": "^file:"
                },
                "files": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/$defs/relativePath"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sha256",
                      "mode"
                    ],
                    "properties": {
                      "sha256": {
                        "$ref": "#/$defs/sha256"
                      },
                      "mode": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 511
                      }
                    }
                  }
                },
                "installation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "root",
                    "lockSha256",
                    "files"
                  ],
                  "properties": {
                    "root": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lockSha256": {
                      "$ref": "#/$defs/sha256"
                    },
                    "files": {
                      "type": "object",
                      "propertyNames": {
                        "$ref": "#/$defs/relativePath"
                      },
                      "additionalProperties": {
                        "oneOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "sha256",
                              "mode"
                            ],
                            "properties": {
                              "kind": {
                                "const": "file"
                              },
                              "sha256": {
                                "$ref": "#/$defs/sha256"
                              },
                              "mode": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 511
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "target"
                            ],
                            "properties": {
                              "kind": {
                                "const": "symlink"
                              },
                              "target": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "preparedAt",
        "installedAt",
        "rolledBackAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "state": {
          "enum": [
            "prepared",
            "installed",
            "rolledBack"
          ]
        },
        "preparedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "installedAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "rolledBackAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "prepared"
              }
            }
          },
          "then": {
            "properties": {
              "installedAt": {
                "type": "null"
              },
              "rolledBackAt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "installed"
              }
            }
          },
          "then": {
            "properties": {
              "installedAt": {
                "$ref": "#/$defs/timestamp"
              },
              "rolledBackAt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "rolledBack"
              }
            }
          },
          "then": {
            "properties": {
              "rolledBackAt": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        }
      ]
    },
    "backupDirectory": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "pattern": "^\\.automation-plugin/backups/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source",
          "strategy",
          "sha256",
          "size",
          "mode",
          "previous"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/managedPath"
          },
          "source": {
            "$ref": "#/$defs/relativePath"
          },
          "strategy": {
            "enum": [
              "copy",
              "generate",
              "merge"
            ]
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          },
          "previous": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "existed",
              "sha256",
              "size",
              "mode",
              "backupPath"
            ],
            "properties": {
              "existed": {
                "type": "boolean"
              },
              "sha256": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/sha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "size": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mode": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "backupPath": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/relativePath"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "existed": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "sha256": {
                      "type": "null"
                    },
                    "size": {
                      "type": "null"
                    },
                    "mode": {
                      "type": "null"
                    },
                    "backupPath": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "existed": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "sha256": {
                      "$ref": "#/$defs/sha256"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "mode": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 511
                    },
                    "backupPath": {
                      "$ref": "#/$defs/relativePath"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
