{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frankzhang2026:opencode-android-orchestrator:task-contract:v8",
  "title": "Scheduled coding task contract",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "gradleTask": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z][A-Za-z0-9_.-]*|(?::[A-Za-z0-9_.-]+)+)$"
    },
    "testFilter": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.#$*-]+$"
    },
    "expectedFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "origin"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "messageIncludes": {
          "type": "string",
          "minLength": 3
        },
        "origin": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 12
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "className",
                "methodName"
              ],
              "properties": {
                "className": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_.$]*$"
                },
                "methodName": {
                  "type": "string",
                  "minLength": 1
                },
                "fileName": {
                  "type": "string",
                  "minLength": 1
                },
                "lineNumber": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "dependentRequired": {
                "lineNumber": [
                  "fileName"
                ]
              }
            }
          ]
        }
      }
    },
    "verificationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "criterion",
        "intent",
        "before",
        "after",
        "source",
        "test"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
        },
        "criterion": {
          "type": "integer",
          "minimum": 1
        },
        "intent": {
          "enum": [
            "preserve",
            "change",
            "observe"
          ]
        },
        "before": {
          "enum": [
            "pass",
            "fail",
            "observe"
          ]
        },
        "after": {
          "const": "pass"
        },
        "source": {
          "enum": [
            "userRequirement",
            "existingTest",
            "baselineCapture",
            "measuredFact"
          ]
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "className",
            "name"
          ],
          "properties": {
            "target": {
              "type": "integer",
              "minimum": 0
            },
            "className": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "expectedFailure": {
          "$ref": "#/$defs/expectedFailure"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "intent": {
                "const": "preserve"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "const": "pass"
              },
              "source": {
                "enum": [
                  "existingTest",
                  "baselineCapture",
                  "measuredFact"
                ]
              }
            },
            "not": {
              "required": [
                "expectedFailure"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "intent": {
                "const": "change"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "const": "fail"
              },
              "source": {
                "const": "userRequirement"
              }
            },
            "required": [
              "expectedFailure"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "intent": {
                "const": "observe"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "const": "observe"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "designApproved",
    "planPath",
    "ambiguityPolicy",
    "maxFixLoops",
    "maxChangedFiles",
    "allowedPaths",
    "forbiddenPaths",
    "allowedWorkflowSkills",
    "acceptanceCriteria",
    "nonGoals",
    "targetTests",
    "deviceTestsRequired",
    "testPolicy",
    "verification"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        3,
        4,
        5,
        6,
        7,
        8
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "designApproved": {
      "const": true
    },
    "planPath": {
      "type": "string",
      "minLength": 1
    },
    "ambiguityPolicy": {
      "const": "BLOCKED"
    },
    "maxFixLoops": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "maxChangedFiles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedWorkflowSkills": {
      "type": "array",
      "const": [
        "android-orchestrator-test-driven-development",
        "android-orchestrator-systematic-debugging",
        "android-orchestrator-verification-before-completion"
      ]
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonGoals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetTests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gradleTask",
          "filter"
        ],
        "properties": {
          "gradleTask": {
            "$ref": "#/$defs/gradleTask"
          },
          "filter": {
            "$ref": "#/$defs/testFilter"
          }
        }
      }
    },
    "deviceTestsRequired": {
      "type": "boolean"
    },
    "testPolicy": {
      "enum": [
        "required",
        "not-required"
      ]
    },
    "testPolicyReason": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "maxPreparationFixes",
        "cases"
      ],
      "properties": {
        "version": {
          "enum": [
            1,
            2
          ]
        },
        "maxPreparationFixes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/verificationCase"
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "existingSkips",
            "emptyBaseline"
          ],
          "properties": {
            "mode": {
              "const": "focusedBaseline"
            },
            "existingSkips": {
              "enum": [
                "reject",
                "preserve"
              ]
            },
            "emptyBaseline": {
              "enum": [
                "reject",
                "allow"
              ]
            }
          }
        },
        "criteriaEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "kind",
              "references"
            ],
            "properties": {
              "criterion": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "behavior",
                  "build",
                  "lint",
                  "device"
                ]
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "supplementalTests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "maxRevisions"
          ],
          "properties": {
            "mode": {
              "const": "baselinePassingNewFiles"
            },
            "maxRevisions": {
              "const": 1
            }
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "scope",
        "maxEnvironmentRetries",
        "maxManualRetries",
        "maxSameFailureRetries",
        "maxElapsedMs",
        "initialDelayMs",
        "maxDelayMs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "scope": {
          "const": "baseline"
        },
        "maxEnvironmentRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "maxManualRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "maxSameFailureRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "maxElapsedMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        },
        "initialDelayMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "maxDelayMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "maxRunMs",
        "maxStageMs",
        "terminationGraceMs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "maxRunMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        },
        "maxStageMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        },
        "terminationGraceMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        }
      }
    },
    "stageRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "maxEnvironmentRetries",
        "maxElapsedMs",
        "initialDelayMs",
        "maxDelayMs",
        "maxSameFailureRetries"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "maxEnvironmentRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "maxElapsedMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        },
        "initialDelayMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "maxDelayMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "maxSameFailureRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "isolatedAutoIntegration",
        "planningRefresh",
        "planningInputs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "isolatedAutoIntegration": {
          "type": "boolean"
        },
        "planningRefresh": {
          "enum": [
            "reject",
            "completedQueueTasks"
          ]
        },
        "planningInputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9._/?*-]+$",
            "not": {
              "pattern": "(^/|\\.\\.|(^|/)(\\.git|\\.)(/|$)|//|/$)"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              4,
              5,
              6,
              7,
              8
            ]
          }
        }
      },
      "then": {
        "properties": {
          "testPolicy": {
            "const": "required"
          },
          "targetTests": {
            "items": {
              "properties": {
                "gradleTask": {
                  "pattern": "^(?::[A-Za-z0-9_.-]+)+$"
                }
              }
            }
          },
          "verification": {
            "required": [
              "inventory"
            ],
            "properties": {
              "version": {
                "const": 2
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "verification": {
            "properties": {
              "version": {
                "const": 1
              }
            },
            "not": {
              "required": [
                "inventory"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              5,
              6,
              7,
              8
            ]
          }
        }
      },
      "then": {
        "required": [
          "recovery"
        ]
      },
      "else": {
        "not": {
          "required": [
            "recovery"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              6,
              7,
              8
            ]
          }
        }
      },
      "then": {
        "required": [
          "execution"
        ]
      },
      "else": {
        "not": {
          "required": [
            "execution"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              7,
              8
            ]
          }
        }
      },
      "then": {
        "required": [
          "stageRecovery"
        ]
      },
      "else": {
        "not": {
          "required": [
            "stageRecovery"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 8
          }
        }
      },
      "then": {
        "required": [
          "continuity"
        ]
      },
      "else": {
        "not": {
          "required": [
            "continuity"
          ]
        }
      }
    }
  ]
}
