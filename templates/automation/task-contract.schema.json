{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frankzhang2026:opencode-android-orchestrator:task-contract:v2",
  "title": "Scheduled coding task contract",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "gradleTask": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z][A-Za-z0-9_.-]*|(?::[A-Za-z0-9_.-]+)+)$"
    },
    "testFilter": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.#$*-]+$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "designApproved",
    "planPath",
    "ambiguityPolicy",
    "maxFixLoops",
    "maxChangedFiles",
    "allowedPaths",
    "forbiddenPaths",
    "allowedWorkflowSkills",
    "acceptanceCriteria",
    "nonGoals",
    "targetTests",
    "deviceTestsRequired",
    "testPolicy"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^TASK-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "designApproved": { "const": true },
    "planPath": { "type": "string", "minLength": 1 },
    "ambiguityPolicy": { "const": "BLOCKED" },
    "maxFixLoops": { "type": "integer", "minimum": 0, "maximum": 1 },
    "maxChangedFiles": { "type": "integer", "minimum": 1, "maximum": 12 },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbiddenPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowedWorkflowSkills": {
      "type": "array",
      "const": [
        "android-orchestrator-test-driven-development",
        "android-orchestrator-systematic-debugging",
        "android-orchestrator-verification-before-completion"
      ]
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonGoals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "targetTests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gradleTask", "filter"],
        "properties": {
          "gradleTask": { "$ref": "#/$defs/gradleTask" },
          "filter": { "$ref": "#/$defs/testFilter" }
        }
      }
    },
    "deviceTestsRequired": { "type": "boolean" },
    "testPolicy": { "enum": ["required", "not-required"] },
    "testPolicyReason": { "type": "string" }
  }
}
