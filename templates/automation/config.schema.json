{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frankzhang2026:opencode-android-orchestrator:automation-config:v3",
  "title": "OpenCode task orchestration configuration",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.\\.(?:/|$))(?![A-Za-z]:[\\\\/]).+"
    },
    "nullableIdentifier": {
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "enabled",
    "mode",
    "workspaceStrategy",
    "originalBranchDriftPolicy",
    "worktreeBase",
    "maxFixLoops",
    "maxReviewCycles",
    "maxReviewerRestarts",
    "autoCleanupWorktrees",
    "pushAfterAcceptance",
    "approvalPhrases",
    "plugins",
    "requiredSkills",
    "androidProject",
    "protectedPaths"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "enabled": { "type": "boolean" },
    "mode": { "enum": ["shadow", "orchestrated"] },
    "workspaceStrategy": {
      "enum": ["inPlaceExclusive", "isolatedWorktree"]
    },
    "originalBranchDriftPolicy": { "const": "block" },
    "worktreeBase": { "type": "string" },
    "maxFixLoops": { "type": "integer", "minimum": 0, "maximum": 1 },
    "maxReviewCycles": { "type": "integer", "minimum": 0, "maximum": 2 },
    "maxReviewerRestarts": { "type": "integer", "minimum": 0, "maximum": 3 },
    "autoCleanupWorktrees": { "type": "boolean" },
    "pushAfterAcceptance": { "const": false },
    "approvalPhrases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal", "contract", "acceptance", "abort"],
      "properties": {
        "proposal": { "type": "string", "minLength": 4 },
        "contract": { "type": "string", "minLength": 4 },
        "acceptance": { "type": "string", "minLength": 4 },
        "abort": { "type": "string", "minLength": 4 }
      }
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["superpowers"],
      "properties": {
        "superpowers": { "type": "string", "minLength": 1 }
      }
    },
    "requiredSkills": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "androidProject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "gradleDsl",
        "settingsFile",
        "primaryModule",
        "modules",
        "productionPaths",
        "testPaths"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "gradleDsl": { "enum": ["kotlin", "groovy", "mixed"] },
        "settingsFile": { "$ref": "#/$defs/repositoryPath" },
        "primaryModule": {
          "type": "string",
          "pattern": "^:(?:[A-Za-z0-9_.-]+(?::[A-Za-z0-9_.-]+)*)?$"
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gradlePath",
              "directory",
              "buildFile",
              "dsl",
              "type",
              "namespace",
              "applicationId"
            ],
            "properties": {
              "gradlePath": {
                "type": "string",
                "pattern": "^:(?:[A-Za-z0-9_.-]+(?::[A-Za-z0-9_.-]+)*)?$"
              },
              "directory": { "$ref": "#/$defs/repositoryPath" },
              "buildFile": { "$ref": "#/$defs/repositoryPath" },
              "dsl": { "enum": ["kotlin", "groovy"] },
              "type": {
                "enum": [
                  "application",
                  "library",
                  "dynamic-feature",
                  "test",
                  "asset-pack"
                ]
              },
              "namespace": { "$ref": "#/$defs/nullableIdentifier" },
              "applicationId": { "$ref": "#/$defs/nullableIdentifier" }
            }
          }
        },
        "productionPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/repositoryPath" },
              { "pattern": "(^|/)src/main/\\*\\*$" }
            ]
          }
        },
        "testPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/repositoryPath" },
              { "pattern": "(^|/)src/(?:test|androidTest)/\\*\\*$" }
            ]
          }
        }
      }
    },
    "protectedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    }
  }
}
