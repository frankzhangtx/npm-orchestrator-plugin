{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frankzhang2026:opencode-android-orchestrator:automation-config:v6",
  "title": "OpenCode task orchestration configuration",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.\\.(?:/|$))(?![A-Za-z]:[\\\\/]).+"
    },
    "nullableIdentifier": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "gradleTask": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z][A-Za-z0-9_.-]*|(?::[A-Za-z0-9_.-]+)+)$"
    },
    "optionalGradleTaskList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gradleTask"
      }
    },
    "gradleTaskList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gradleTask"
      }
    }
  },
  "required": [
    "schemaVersion",
    "enabled",
    "mode",
    "workspaceStrategy",
    "originalBranchDriftPolicy",
    "worktreeBase",
    "maxFixLoops",
    "maxReviewCycles",
    "maxReviewerRestarts",
    "unitTestsEnabled",
    "lintEnabled",
    "commitMessagePrefixMode",
    "longCommandTimeoutMs",
    "autoCleanupWorktrees",
    "pushAfterAcceptance",
    "approvalPhrases",
    "requiredSkills",
    "gradleVerification",
    "androidProject",
    "protectedPaths",
    "commitPolicy",
    "queue"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "enabled": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "shadow",
        "orchestrated"
      ]
    },
    "workspaceStrategy": {
      "enum": [
        "inPlaceExclusive",
        "isolatedWorktree"
      ]
    },
    "originalBranchDriftPolicy": {
      "const": "block"
    },
    "worktreeBase": {
      "type": "string"
    },
    "maxFixLoops": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "maxReviewCycles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "maxReviewerRestarts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "unitTestsEnabled": {
      "type": "boolean",
      "default": true
    },
    "lintEnabled": {
      "type": "boolean",
      "default": false
    },
    "commitMessagePrefixMode": {
      "enum": [
        "required",
        "disabled"
      ],
      "default": "required"
    },
    "longCommandTimeoutMs": {
      "type": "integer",
      "minimum": 120000,
      "maximum": 7200000
    },
    "autoCleanupWorktrees": {
      "type": "boolean"
    },
    "pushAfterAcceptance": {
      "const": false
    },
    "approvalPhrases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "contract",
        "acceptance",
        "abort",
        "resume"
      ],
      "properties": {
        "proposal": {
          "type": "string",
          "minLength": 4
        },
        "contract": {
          "type": "string",
          "minLength": 4
        },
        "acceptance": {
          "type": "string",
          "minLength": 4
        },
        "abort": {
          "type": "string",
          "minLength": 4
        },
        "resume": {
          "type": "string",
          "minLength": 4
        }
      }
    },
    "requiredSkills": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gradleVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullUnitTestTasks",
        "focusedTestTasks",
        "assembleTasks",
        "lintTasks",
        "deviceTestTasks"
      ],
      "properties": {
        "fullUnitTestTasks": {
          "$ref": "#/$defs/gradleTaskList"
        },
        "focusedTestTasks": {
          "$ref": "#/$defs/gradleTaskList"
        },
        "assembleTasks": {
          "$ref": "#/$defs/gradleTaskList"
        },
        "lintTasks": {
          "$ref": "#/$defs/optionalGradleTaskList"
        },
        "deviceTestTasks": {
          "$ref": "#/$defs/optionalGradleTaskList"
        }
      }
    },
    "androidProject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "gradleDsl",
        "settingsFile",
        "primaryModule",
        "modules",
        "productionPaths",
        "testPaths"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "gradleDsl": {
          "enum": [
            "kotlin",
            "groovy",
            "mixed"
          ]
        },
        "settingsFile": {
          "$ref": "#/$defs/repositoryPath"
        },
        "moduleScope": {
          "enum": [
            "all",
            "primary"
          ]
        },
        "primaryModule": {
          "type": "string",
          "pattern": "^:(?:[A-Za-z0-9_.-]+(?::[A-Za-z0-9_.-]+)*)?$"
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gradlePath",
              "directory",
              "buildFile",
              "dsl",
              "type",
              "namespace",
              "applicationId"
            ],
            "properties": {
              "gradlePath": {
                "type": "string",
                "pattern": "^:(?:[A-Za-z0-9_.-]+(?::[A-Za-z0-9_.-]+)*)?$"
              },
              "directory": {
                "$ref": "#/$defs/repositoryPath"
              },
              "buildFile": {
                "$ref": "#/$defs/repositoryPath"
              },
              "dsl": {
                "enum": [
                  "kotlin",
                  "groovy"
                ]
              },
              "type": {
                "enum": [
                  "application",
                  "library",
                  "dynamic-feature",
                  "test",
                  "asset-pack",
                  "jvm-library"
                ]
              },
              "namespace": {
                "$ref": "#/$defs/nullableIdentifier"
              },
              "applicationId": {
                "$ref": "#/$defs/nullableIdentifier"
              }
            }
          }
        },
        "productionPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "testPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "buildRoot",
            "modules"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "buildRoot": {
              "$ref": "#/$defs/repositoryPath"
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "gradlePath",
                  "directory",
                  "buildFile",
                  "type",
                  "namespace",
                  "applicationId",
                  "dependencies",
                  "sources",
                  "tasks"
                ],
                "properties": {
                  "gradlePath": {
                    "type": "string",
                    "pattern": "^:(?:[A-Za-z0-9_.-]+(?::[A-Za-z0-9_.-]+)*)?$"
                  },
                  "directory": {
                    "$ref": "#/$defs/repositoryPath"
                  },
                  "buildFile": {
                    "$ref": "#/$defs/repositoryPath"
                  },
                  "type": {
                    "enum": [
                      "application",
                      "library",
                      "dynamic-feature",
                      "test",
                      "asset-pack",
                      "jvm-library"
                    ]
                  },
                  "namespace": {
                    "$ref": "#/$defs/nullableIdentifier"
                  },
                  "applicationId": {
                    "$ref": "#/$defs/nullableIdentifier"
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^:(?:[A-Za-z0-9_.-]+(?::[A-Za-z0-9_.-]+)*)?$"
                    },
                    "uniqueItems": true
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "kind",
                        "paths"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.-]+$"
                        },
                        "kind": {
                          "enum": [
                            "production",
                            "test"
                          ]
                        },
                        "paths": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/repositoryPath"
                          },
                          "uniqueItems": true
                        }
                      }
                    },
                    "uniqueItems": true
                  },
                  "tasks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "kind",
                        "variant"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "pattern": "^:(?:[A-Za-z0-9_.-]+:)*[A-Za-z][A-Za-z0-9_.-]*$"
                        },
                        "kind": {
                          "enum": [
                            "unit",
                            "assemble",
                            "lint",
                            "device"
                          ]
                        },
                        "variant": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^[A-Za-z0-9]+$"
                        }
                      }
                    },
                    "uniqueItems": true
                  }
                }
              },
              "uniqueItems": true,
              "minItems": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "capabilities"
            ]
          },
          "then": {},
          "else": {
            "properties": {
              "productionPaths": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/repositoryPath"
                    },
                    {
                      "pattern": "(^|/)src/main/\\*\\*$"
                    }
                  ]
                }
              },
              "testPaths": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/repositoryPath"
                    },
                    {
                      "pattern": "(^|/)src/(?:test|androidTest)/\\*\\*$"
                    }
                  ]
                }
              },
              "modules": {
                "items": {
                  "properties": {
                    "type": {
                      "enum": [
                        "application",
                        "library",
                        "dynamic-feature",
                        "test",
                        "asset-pack"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "protectedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "commitPolicy": {
      "enum": [
        "humanApproval",
        "autoCommit"
      ],
      "default": "humanApproval"
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanIntervalMs",
        "maxWorkspaces",
        "maxWorkspaceBytes"
      ],
      "properties": {
        "scanIntervalMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "maxWorkspaces": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxWorkspaceBytes": {
          "type": "integer",
          "minimum": 1,
          "default": 21474836480
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lintEnabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "gradleVerification": {
            "properties": {
              "lintTasks": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
