{
  "schemaVersion": 3,
  "id": "TASK-EXAMPLE-001",
  "title": "Replace with one small, observable behavior change",
  "designApproved": true,
  "planPath": "docs/plans/TASK-EXAMPLE-001.md",
  "ambiguityPolicy": "BLOCKED",
  "maxFixLoops": 1,
  "maxChangedFiles": 4,
  "allowedPaths": [
    "**/src/main/**",
    "**/src/test/**",
    "**/src/androidTest/**"
  ],
  "forbiddenPaths": [
    ".automation-worktree-allowlist",
    ".opencode/**",
    ".automation-plugin/**",
    "automation/**",
    "scripts/automation/**",
    "opencode.json",
    "opencode.jsonc",
    "AGENTS.md",
    "gradle/**",
    "gradlew",
    "gradlew.bat",
    "settings.gradle",
    "settings.gradle.kts",
    "build.gradle",
    "build.gradle.kts",
    "**/build.gradle",
    "**/build.gradle.kts"
  ],
  "allowedWorkflowSkills": [
    "android-orchestrator-test-driven-development",
    "android-orchestrator-systematic-debugging",
    "android-orchestrator-verification-before-completion"
  ],
  "acceptanceCriteria": [
    "Replace with an observable input/output or UI behavior",
    "A focused test demonstrates the behavior and is captured RED before implementation",
    "Debug build passes; unit tests and Android lint also pass when their configuration flags are enabled"
  ],
  "nonGoals": [
    "Do not refactor unrelated screens",
    "Do not upgrade dependencies or Gradle configuration"
  ],
  "targetTests": [
    {
      "gradleTask": "testDebugUnitTest",
      "filter": "*ReplaceWithFocusedTest"
    }
  ],
  "deviceTestsRequired": false,
  "testPolicy": "required",
  "testPolicyReason": "Behavior changes require a focused regression test",
  "verification": {
    "version": 1,
    "maxPreparationFixes": 1,
    "cases": [
      {
        "id": "FOCUSED-BEHAVIOR",
        "criterion": 1,
        "intent": "change",
        "before": "fail",
        "after": "pass",
        "source": "userRequirement",
        "test": {
          "target": 0,
          "className": "ReplaceWithFocusedTest",
          "name": "replace with observable behavior"
        },
        "expectedFailure": {
          "type": "java.lang.AssertionError",
          "origin": "The assertion at the approved behavior call"
        }
      }
    ]
  }
}
