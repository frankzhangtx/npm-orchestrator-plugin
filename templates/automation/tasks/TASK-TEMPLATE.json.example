{
  "schemaVersion": 1,
  "id": "TASK-EXAMPLE-001",
  "title": "Replace with one small, observable behavior change",
  "designApproved": true,
  "planPath": "docs/plans/TASK-EXAMPLE-001.md",
  "ambiguityPolicy": "BLOCKED",
  "maxFixLoops": 1,
  "maxChangedFiles": 4,
  "allowedPaths": [
    "**/src/main/**",
    "**/src/test/**",
    "**/src/androidTest/**"
  ],
  "forbiddenPaths": [
    ".opencode/**",
    ".automation-plugin/**",
    "automation/**",
    "scripts/automation/**",
    "opencode.json",
    "opencode.jsonc",
    "AGENTS.md",
    "gradle/**",
    "gradlew",
    "gradlew.bat",
    "settings.gradle",
    "settings.gradle.kts",
    "build.gradle",
    "build.gradle.kts",
    "**/build.gradle",
    "**/build.gradle.kts"
  ],
  "allowedSuperpowers": [
    "test-driven-development",
    "systematic-debugging",
    "verification-before-completion"
  ],
  "acceptanceCriteria": [
    "Replace with an observable input/output or UI behavior",
    "A focused test demonstrates the behavior and is captured RED before implementation",
    "Unit tests, debug build, and lint all pass"
  ],
  "nonGoals": [
    "Do not refactor unrelated screens",
    "Do not upgrade dependencies or Gradle configuration"
  ],
  "targetTests": [
    {
      "gradleTask": "testDebugUnitTest",
      "filter": "*ReplaceWithFocusedTest"
    }
  ],
  "deviceTestsRequired": false,
  "testPolicy": "required",
  "testPolicyReason": "Behavior changes require a focused regression test"
}
